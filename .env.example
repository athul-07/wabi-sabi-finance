SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_server_only_secret
# Exact origin, without a trailing slash. Use the deployed HTTPS domain on Vercel.
APP_ORIGIN=http://localhost:4000
# Vercel production deployments should use NODE_ENV=production.
# Set a random 16+ character value in Vercel Production for the daily cron.
# CRON_SECRET=replace_with_a_random_secret
