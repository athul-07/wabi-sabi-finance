{
  "name": "wabi-sabi-finance",
  "version": "1.0.0",
  "description": "Wabi Sabi — Sales & Rentals finance app (multi-device server + web frontend)",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "build": "node scripts/build.js",
    "prestart": "npm run build",
    "start": "node src/server.js",
    "dev": "npm run build && node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "setup:admin": "node src/adduser.js --admin",
    "adduser": "node src/adduser.js",
    "import": "node src/import-workbook.js"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.51.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^3.4.17"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
